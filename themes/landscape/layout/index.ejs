<%
  var posts = page.posts ? page.posts.toArray() : [];
  var tags = site.tags ? site.tags.toArray().sort(function(a, b){ return a.name.localeCompare(b.name); }) : [];
  var postEntries = posts.map(function(post, index){
    var tagList = post.tags ? post.tags.toArray() : [];
    var tagNames = tagList.map(function(tag){ return tag.name; });
    return {
      post: post,
      tagList: tagList,
      tagNames: tagNames,
      summary: post.desc || post.excerpt || '',
      anchorId: 'doc-' + (post.slug || ('post-' + index))
    };
  });
%>

<section class="doc-home">
  <section class="hero-banner">
    <div class="hero-copy">
      <h1><%= config.title %></h1>
      <p class="hero-text"><%= config.description || config.subtitle || "按主题沉淀文章，像文档一样浏览与定位。" %></p>
      <div class="hero-bottom">
        <div class="hero-meta">
          <span><strong><%= posts.length %></strong> 篇文章</span>
          <span aria-hidden="true">·</span>
          <span><strong><%= tags.length %></strong> 个标签</span>
        </div>
      </div>
    </div>
  </section>

  <div class="doc-home-grid" data-home-root data-home-directory-root>
    <section class="doc-feed" id="articles" aria-labelledby="articles-title">
      <div class="doc-feed-heading">
        <p class="section-kicker">Writing</p>
        <h2 id="articles-title">文章</h2>
      </div>
      <% postEntries.forEach(function(entry, index){ %>
        <article class="doc-card" id="<%= entry.anchorId %>" data-doc-card data-card-tags="<%= entry.tagNames.join('|') %>">
          <time class="doc-card-date" datetime="<%= entry.post.date.format('YYYY-MM-DD') %>">
            <span><%= entry.post.date.format('YYYY') %></span>
            <strong><%= entry.post.date.format('MM/DD') %></strong>
          </time>
          <div class="doc-card-body">
            <h3><a href="<%- url_for(entry.post.path) %>"><%= entry.post.title %></a></h3>
            <% if (entry.summary) { %>
              <div class="doc-card-summary"><%- entry.summary %></div>
            <% } %>
            <% if (entry.tagList.length) { %>
              <div class="doc-card-tags">
                <% entry.tagList.forEach(function(tag){ %>
                  <button class="doc-tag" type="button" data-filter-tag="<%= tag.name %>"><%= tag.name %></button>
                <% }) %>
              </div>
            <% } %>
          </div>
          <a class="doc-card-read" href="<%- url_for(entry.post.path) %>" aria-label="阅读《<%= entry.post.title %>》">阅读全文</a>
        </article>
      <% }) %>
      <div class="doc-empty-state" data-empty-state hidden>当前筛选下没有文章。</div>
    </section>

    <aside class="doc-directory" aria-label="筛选与快速导航" aria-hidden="false">
      <div class="doc-directory-inner">
        <section class="filter-strip" id="filters" data-filter-root aria-labelledby="filter-title">
          <div class="filter-strip-head">
            <div>
              <p class="section-kicker">Topics</p>
              <h2 id="filter-title">标签</h2>
            </div>
            <p class="filter-state" data-filter-label>当前：全部</p>
          </div>
          <div class="filter-chip-list">
            <button class="filter-chip is-active" type="button" data-filter-control="all">全部</button>
            <% tags.forEach(function(tag){ %>
              <button class="filter-chip" type="button" data-filter-control="<%= tag.name %>"><%= tag.name %> <span><%= tag.length %></span></button>
            <% }) %>
          </div>
        </section>

        <section class="directory-section" aria-labelledby="directory-title">
          <div class="doc-page-toc-head">
            <div>
              <p class="section-kicker">Directory</p>
              <h2 id="directory-title">目录</h2>
            </div>
            <button class="doc-mobile-toc-close" type="button" data-mobile-directory-close aria-label="关闭目录">关闭</button>
          </div>
          <nav class="doc-directory-list" data-directory-list>
            <% postEntries.forEach(function(entry, index){ %>
              <a href="#<%= entry.anchorId %>" data-directory-item data-card-tags="<%= entry.tagNames.join('|') %>"><span><%= String(index + 1).padStart(2, '0') %></span><%= entry.post.title %></a>
            <% }) %>
          </nav>
        </section>

        <section class="quick-links" aria-labelledby="quick-links-title">
          <p class="section-kicker">Links</p>
          <h2 id="quick-links-title">快速导航</h2>
          <a href="#articles"><strong>全部文章</strong><span>回到文章列表</span></a>
          <a href="https://github.com/qinghuan-yu" target="_blank" rel="noopener noreferrer"><strong>GitHub</strong><span>查看源码与项目</span></a>
          <a href="mailto:reliarc.me@outlook.com"><strong>邮件联系</strong><span>reliarc.me@outlook.com</span></a>
        </section>
      </div>
    </aside>

    <button class="doc-mobile-toc-trigger" type="button" data-mobile-directory-trigger aria-expanded="false">目录</button>
    <div class="doc-mobile-toc-mask" data-mobile-directory-mask hidden></div>
  </div>
</section>
